# Supabase public client configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-jwt

# Toss Payments browser client key. This is public and must use the VITE_ prefix.
# Used only as a local browser fallback outside the Apps in Toss runtime.
VITE_TOSS_PAYMENTS_CLIENT_KEY=test_ck_your-client-key

# Apps in Toss rewarded/full-screen ad group. Use the console-issued ID in production.
VITE_APPS_IN_TOSS_REWARDED_AD_GROUP_ID=ait-ad-test-rewarded-id

# Server-only secrets. Never expose these with a VITE_ prefix.
TOSS_PAYMENTS_SECRET_KEY=test_sk_your-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional analytics parity with the Flutter app.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
