{
    "extends": "./tsconfig.json",
    "include": [
        ".react-router/types/**/*",
        "app/root.tsx",
        "app/routes.ts",
        "app/entry.server.tsx",
        "app/features/sadam/**/*.ts",
        "app/features/sadam/**/*.tsx",
        "app/common/components/ui/badge.tsx",
        "app/common/components/ui/button.tsx",
        "app/lib/utils.ts",
        "workers/**/*",
        "worker-configuration.d.ts"
    ],
    "compilerOptions": {
        "composite": true,
        "strict": true,
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2022"
        ],
        "types": [
            "@cloudflare/workers-types",
            "vite/client",
            "node"
        ],
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "baseUrl": ".",
        "rootDirs": [
            ".",
            "./.react-router/types"
        ],
        "paths": {
            "~/*": [
                "./app/*"
            ]
        },
        "esModuleInterop": true,
        "resolveJsonModule": true
    }
}
